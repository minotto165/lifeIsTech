# 自動ログイン用（任意）。未設定でも Chrome に保存された ID / パスワードが
# 自動入力されていれば、それをそのまま送信してログインする。
# パスワードを平文で置くことになるので、取り扱いには注意。
LIFEISTECH_ID=
LIFEISTECH_PASSWORD=

# OpenCode Go の API キー（https://opencode.ai/console/account#api-keys）
OPENCODE_GO_API_KEY=your_api_key_here

# OpenCode Go が使えないときのフォールバック用（任意）
GEMINI_API_KEY=
